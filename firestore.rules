rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents: readable by authenticated users (for contact discovery), writable only by owner
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // User conversations (sections)
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);

        // Messages inside a conversation
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Direct chats between users
    match /direct_chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // App updates: readable by anyone, writable only by admins
    match /app_updates/{updateId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
